# CodeSlim Environment Configuration Template

# Provider Selection: "ollama" or "openai"
LLM_PROVIDER=ollama

# Model Configuration
LLM_MODEL_ANALYSIS=qwen2.5-coder:3b
LLM_MODEL_OPTIMIZATION=qwen2.5-coder:3b

# Local Ollama Configuration (Local-First execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_FALLBACK=qwen2.5-coder:3b

# Cloud Fallback Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# GitHub PR Bot Configuration
CODESLIM_GITHUB_TOKEN=your_github_token_here
CODESLIM_GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
